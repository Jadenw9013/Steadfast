{
  "name": "coach-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "SMOKE=1 vitest run",
    "release-check": "bash release.sh",
    "ai-coach:release-evidence": "bash scripts/ai-coach-release-evidence.sh",
    "ai-coach:kill-switch-drill": "bash scripts/ai-coach-kill-switch-drill.sh",
    "ai-coach:launch-packet:check": "tsx scripts/validate-ai-coach-live-launch-packet.ts --draft docs/ai-coach/approval/live-launch-packet.template.v1.json",
    "ai-coach:launch-readiness-drill": "bash scripts/ai-coach-live-launch-readiness-drill.sh",
    "ai-coach:activate": "tsx scripts/activate-ai-coach-live-release.ts",
    "ai-coach:deactivate": "tsx scripts/deactivate-ai-coach-live-release.ts",
    "ai-coach:final-provider-evaluation": "tsx scripts/evaluate-ai-coach-final-provider.ts",
    "ai-coach:alerts": "tsx scripts/check-ai-coach-operational-alerts.ts",
    "ai-coach:staging-preflight": "bash scripts/ai-coach-staging-preflight.sh",
    "ai-coach:bootstrap-governance": "tsx scripts/bootstrap-ai-coach-governance.ts",
    "ai-coach:grant": "tsx scripts/manage-ai-coach-grants.ts",
    "ai-coach:sweep": "tsx scripts/ai-coach-sweep.ts",
    "ai-coach:seed-fixtures": "tsx scripts/ai-coach-seed-fixtures.ts",
    "ai-coach:fdc:propose": "tsx scripts/ai-coach-ingest-fdc.ts",
    "ai-coach:fdc:ingest": "tsx scripts/ai-coach-ingest-fdc.ts",
    "prisma:replay": "bash scripts/replay-prisma-migrations.sh",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@clerk/nextjs": "^6.37.4",
    "@clerk/themes": "^2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "dayjs": "^1.11.19",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.4",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.3",
    "sharp": "0.35.4",
    "stripe": "^22.5.0",
    "twilio": "^5.12.2",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.8.3",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
