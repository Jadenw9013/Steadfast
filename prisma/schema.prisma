generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  COACH
  CLIENT
}

enum IntakeStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CheckInStatus {
  SUBMITTED
  REVIEWED
}

enum NotificationType {
  MEAL_PLAN_UPDATE
  CHECKIN_REMINDER
}

enum ReminderStage {
  PRE_DUE
  OVERDUE
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id                        String   @id @default(cuid())
  clerkId                   String   @unique
  email                     String   @unique
  firstName                 String?
  lastName                  String?
  profilePhotoPath          String?
  clientBio                 String?  @db.Text
  fitnessGoal               String?
  activeRole                Role     @default(CLIENT) @map("role")
  isCoach                   Boolean  @default(false)
  isClient                  Boolean  @default(true)
  phoneNumber               String?
  apnsToken                 String?
  smsOptIn                  Boolean  @default(false)
  smsMealPlanUpdates        Boolean  @default(false)
  smsDailyCheckInReminder   Boolean  @default(false)
  smsCoachMessages          Boolean  @default(false)
  smsCheckInFeedback        Boolean  @default(false)
  smsCheckInReminderTime    String   @default("19:00")
  smsClientCheckIns         Boolean  @default(false)
  smsMissedCheckInAlerts    Boolean  @default(false)
  smsClientMessages         Boolean  @default(false)
  smsNewClientSignups       Boolean  @default(false)
  smsMissedCheckInAlertTime String   @default("21:00")
  emailCheckInReminders     Boolean  @default(true)
  emailMealPlanUpdates      Boolean  @default(true)
  emailCoachMessages        Boolean  @default(true)
  emailClientCheckIns       Boolean  @default(true)
  emailClientMessages       Boolean  @default(true)
  emailCoachingRequests     Boolean  @default(true)
  pushMealPlanUpdates       Boolean  @default(true)
  pushCheckInReminders      Boolean  @default(true)
  pushCoachMessages         Boolean  @default(true)
  pushClientCheckIns        Boolean  @default(true)
  pushClientMessages        Boolean  @default(true)
  pushCoachingRequests      Boolean  @default(true)
  defaultNotifyOnPublish    Boolean  @default(true)
  checkInDaysOfWeek         Int[]    @default([1]) // 0=Sun..6=Sat. Default: Monday
  cadenceConfig             Json? // CadenceConfig object (null = legacy checkInDaysOfWeek)
  timezone                  String   @default("America/New_York")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  coachAssignments  CoachClient[]      @relation("Coach")
  clientAssignments CoachClient[]      @relation("Client")
  checkIns          CheckIn[]
  clientMessages    Message[]          @relation("ClientMessages")
  sentMessages      Message[]          @relation("SentMessages")
  coachScopedMessages Message[]        @relation("CoachScopedMessages")
  macroTargets      MacroTarget[]      @relation("MacroTargets")
  mealPlans         MealPlan[]         @relation("MealPlans")
  foodLibrary       FoodLibraryItem[]  @relation("FoodLibrary")
  coachUploads      MealPlanUpload[]   @relation("CoachUploads")
  clientUploads     MealPlanUpload[]   @relation("ClientUploads")
  notificationLogs  NotificationLog[]
  checkInTemplates  CheckInTemplate[]  @relation("CheckInTemplates")
  trainingPrograms  TrainingProgram[]  @relation("TrainingPrograms")
  trainingTemplates TrainingTemplate[] @relation("TrainingTemplates")
  workoutImports    WorkoutImport[]    @relation("WorkoutImports")
  coachProfile      CoachProfile?      @relation("MarketplaceProfile")
  prospectRequests  CoachingRequest[]  @relation("ProspectRequests")
  planSnippets      PlanSnippet[]      @relation("PlanSnippets")

  onboardingForm     OnboardingForm?     @relation("CoachOnboardingForm")
  onboardingResponse OnboardingResponse? @relation("ClientOnboardingResponse")

  intakesSent    ClientIntake[] @relation("CoachIntakes")
  intakeReceived ClientIntake?  @relation("ClientIntakes")

  dailyAdherences DailyAdherence[] @relation("DailyAdherences")
  exerciseResults ExerciseResult[] @relation("ExerciseResults")

  testimonialsByCoach  Testimonial[] @relation("CoachTestimonials")
  testimonialsByClient Testimonial[] @relation("ClientTestimonials")
  savedCoaches         SavedCoach[]  @relation("UserSavedCoaches")

  clientInvitesSent    ClientInvite[]        @relation("CoachInvites")
  consultationMeetings ConsultationMeeting[] @relation("CoachMeetings")
  coachSettings        CoachSettings?        @relation("CoachSettings")

  teamId   String? @map("team_id")
  teamRole String? @map("team_role")
  team     Team?   @relation(fields: [teamId], references: [id])

  intakeFormTemplate IntakeFormTemplate?
  coachDocuments     CoachDocument[]

  isDeactivated   Boolean                 @default(false)
  deletionRequest AccountDeletionRequest?

  blockedUsers   UserBlock[] @relation("BlockedByMe")
  blockedByUsers UserBlock[] @relation("BlockedMe")

  reportsFiled   MessageReport[] @relation("ReportsFiled")
  reportsAgainst MessageReport[] @relation("ReportsAgainst")

  coachSubscription CoachSubscription?

  coachingContext    ClientCoachingContext?
  aiCoachProfile     AiCoachProfile?
  aiCoachEntitlement AiCoachEntitlement?
  aiCoachRuns          AiCoachRun[]
  aiPlanVersions       AiPlanVersion[]
  aiAdjustmentSlots    AiAdjustmentSlot[]
  aiWorkoutSessions    AiWorkoutSession[]
  aiCoachReviewerGrant AiCoachReviewerGrant?
  aiIntakeDraft        AiIntakeDraft?
  aiSafetyDisclosures  AiSafetyDisclosureEvent[]
  aiPlanAcceptanceReceipts AiPlanAcceptanceReceipt[]
  aiPlanAcceptanceOutbox   AiPlanAcceptanceOutbox[]
  aiOperationReceipts     AiOperationReceipt[]
  aiObservations          AiCheckInObservation[]
}

enum CoachingMode {
  NONE
  HUMAN
  AI
}

// docs/ai-coach/05-API-and-State-Contracts.md — the single current-provider
// authority (A01/CB06). Every writer that creates or deletes a CoachClient
// row must reconcile this in the same transaction (see
// lib/activation.ts's reconcileCoachingContextForClient). Ambiguous legacy
// state (more than one CoachClient row for a client — not possible today,
// verified zero occurrences before this migration, but not enforced by a
// DB constraint) sets resolutionRequired instead of guessing an active one.
model ClientCoachingContext {
  id                  String       @id @default(cuid())
  clientId            String       @unique
  mode                CoachingMode @default(NONE)
  activeCoachClientId String?      @unique
  revision            Int          @default(0)
  resolutionRequired  Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  client            User        @relation(fields: [clientId], references: [id])
  activeCoachClient CoachClient? @relation(fields: [activeCoachClientId], references: [id])
}

// Persistent AI-coaching identity for a client (A01). Retained across
// pause/re-enrollment; the confirmed intake payload and clinical policy
// content are added by later A-series slices. `activePlanVersionId` has no
// FK yet — AiPlanVersion doesn't exist until A02.
model AiCoachProfile {
  isSynthetic Boolean @default(false) // Explicit test subject; never client-writable.
  id                   String    @id @default(cuid())
  clientId             String    @unique
  profileRevision      Int       @default(0)
  observationRevision  Int       @default(0)
  safetyRevision       Int       @default(0)
  reviewTimezone       String?
  activePlanVersionId  String?
  consentedAt          DateTime?

  // Confirmed structured intake (A03) — set only by an explicit confirm
  // action, never by a draft save. A new allergy or goal change cannot
  // remain only in a pending draft (docs/ai-coach/05).
  confirmedIntake Json?

  // Current safety disposition and per-domain permissions (A03). Only
  // submitSafetyDisclosure (lib/ai-coach/safety.ts) may change these — it
  // can increase caution but never clear a restriction; clearing is a
  // separate, deliberate reviewed-resolution action (clearSafetyRestriction),
  // never reachable from the client's own disclosure submission.
  safetyDisposition   AiSafetyDisposition @default(CLEAR)
  nutritionPermission AiDomainPermission  @default(ALLOW)
  strengthPermission  AiDomainPermission  @default(ALLOW)
  cardioPermission    AiDomainPermission  @default(ALLOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])
}

enum AiSafetyDisposition {
  CLEAR
  CLARIFY
  RESTRICTED
  REFER
  URGENT
}

enum AiDomainPermission {
  ALLOW
  HOLD_ONLY
  PAUSED
}

// Unconfirmed, partially-completed intake — separate from
// AiCoachProfile.confirmedIntake so an in-progress edit never counts as
// confirmed (A03). Available to an authenticated invited applicant before
// AI becomes the active provider (docs/ai-coach/05).
model AiIntakeDraft {
  id        String   @id @default(cuid())
  clientId  String   @unique
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation(fields: [clientId], references: [id])
}

// Append-only audit log of every safety disclosure received and what it
// changed (A03) — "History remains distinguishable from current advice"
// (docs/ai-coach/06 §1). Never edited or deleted except by account purge.
model AiSafetyDisclosureEvent {
  id                    String              @id @default(cuid())
  clientId              String
  reportedAt            DateTime            @default(now())
  structuredAnswers     Json
  dispositionAfter      AiSafetyDisposition
  nutritionPermissionAfter AiDomainPermission
  strengthPermissionAfter  AiDomainPermission
  cardioPermissionAfter    AiDomainPermission
  safetyRevisionAfter   Int

  client User @relation(fields: [clientId], references: [id])

  @@index([clientId, reportedAt])
}

// Invited-pilot entitlement (A01) — separate from coach billing
// (CoachSubscription) and from provider authority (ClientCoachingContext).
// Grants cannot be self-asserted by a client or by the model; enrollment
// must check this server-side alongside the enrollment feature flag.
model AiCoachEntitlement {
  id         String    @id @default(cuid())
  clientId   String    @unique
  grantedAt  DateTime  @default(now())
  grantedBy  String? // internal id of whoever granted it; null for a seeded/manual grant
  expiresAt  DateTime?
  revokedAt  DateTime?

  client User @relation(fields: [clientId], references: [id])
}

// ── AI Coach: runs, plans, sessions, reviewer grants (A02) ────────────────────
// docs/ai-coach/05-API-and-State-Contracts.md is authoritative for these
// states and transitions. Synthetic-fixture engineering only — no real
// clinical policy, catalog, or live model calls exist yet (A03/A04/A05).

enum AiRunKind {
  INITIAL
  WEEKLY_REVIEW
  REPRESENTATION
}

enum AiRunStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  COMPLETED
  FAILED
  CANCELED
}

enum AiChangeClass {
  INITIAL
  ROUTINE
  TARGET_PRESERVING
  PROTECTIVE
}

enum AiPlanStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  SUPERSEDED
  INVALIDATED
}

enum AiReviewerStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AiLoadKind {
  EXTERNAL
  BODYWEIGHT
  ASSISTED
}

// A durable job record. Duplicate requests must resolve to the same
// business operation (see businessKey); inputs and a completed result are
// immutable once set, only execution metadata (status/lease/attempts)
// changes. Run creation/business-key computation, and the deterministic
// controller itself, are later A-series slices (A03/A04/A09) — this model
// establishes the lifecycle shape and transition invariants only.
model AiCoachRun {
  id       String      @id @default(cuid())
  clientId String
  kind     AiRunKind
  status   AiRunStatus @default(QUEUED)

  // Deduplicates a logical run: derived from client + all relevant
  // revisions + policy/catalog/model-config versions + run kind + active
  // base + activation window + requested representation + retry
  // generation. Computed by the caller (A03/A09); this model only enforces
  // that duplicates collapse to one row.
  businessKey String @unique

  // Frozen inputs, snapshotted at creation and never mutated.
  contextRevision     Int
  profileRevision     Int
  observationRevision Int
  safetyRevision      Int
  lookbackStart       DateTime?
  lookbackEnd         DateTime?
  snapshotCutoffAt    DateTime?
  activationStartsAt  DateTime?
  activationEndsAt    DateTime?

  // Execution/lease metadata — mutable.
  leaseExpiresAt  DateTime?
  fencingToken    Int       @default(0)
  attempts        Int       @default(0)
  retryGeneration Int       @default(0)
  // Explicit lineage for a server-authorized manual retry after terminal
  // failure — a new row, never a reopened terminal one (docs/ai-coach/05).
  retryOfRunId    String?
  lastError       String?   @db.Text

  // A05: the last persisted stage output, written atomically with a
  // RUNNING→QUEUED checkpoint so a resumed run continues from real
  // progress instead of repeating a stage. Never holds prompts/model
  // traces meant for end-user or reviewer display — see run-status.ts.
  checkpointData Json?
  inputSnapshot Json? // Immutable minimized inputs for managed runs.
  resultDecision Json? // Validated safe decision, never a model trace.

  // Result — set once, on the terminal COMPLETED transition.
  resultPlanVersionId String?
  resultReviewAction  AiReviewAction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  User          @relation(fields: [clientId], references: [id])
  retryOf AiCoachRun?   @relation("RunRetryChain", fields: [retryOfRunId], references: [id])
  retries AiCoachRun[]  @relation("RunRetryChain")

  @@index([clientId])
  @@index([status, leaseExpiresAt])
}

enum AiReviewAction {
  HOLD
  SIMPLIFY
  ADJUST
  CLARIFY
  PAUSE_REFER
}

// An immutable canonical AI plan payload. Content never changes once
// created — a correction creates a new version with `baseVersionId`
// pointing at the prior one. `acceptedAt` never resets. AI plans never
// write the legacy MealPlan/TrainingProgram tables (D04).
model AiPlanVersion {
  id            String        @id @default(cuid())
  clientId      String
  version       Int
  baseVersionId String?
  status        AiPlanStatus  @default(PROPOSED)
  changeClass   AiChangeClass?

  // Immutable payload — PlanPayloadV1-shaped (nutrition/meals/strength/
  // cardio). Stored as Json pending A04's reviewed catalog/policy schema;
  // payloadHash lets a reviewer approval bind to the exact content without
  // this model needing to know its internal shape yet.
  payload     Json
  payloadHash String

  // Revisions this version was computed against — an acceptance must
  // recheck these are still current (docs/ai-coach/05 "Atomic acceptance").
  contextRevision     Int
  profileRevision     Int
  observationRevision Int
  safetyRevision      Int

  policyVersion   String
  catalogVersions Json

  activationStartsAt DateTime?
  activationEndsAt   DateTime?

  reviewerStatus       AiReviewerStatus @default(NOT_REQUIRED)
  reviewerApprovalHash String?
  reviewWindowKey String?
  validationReport Json?
  sourceRefs Json?

  acceptedAt DateTime? // permanent once set — never cleared or reused
  // A10: bounded, optional — set only by declinePlanVersion, only from PROPOSED.
  declineReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       User                    @relation(fields: [clientId], references: [id])
  baseVersion  AiPlanVersion?          @relation("PlanVersionHistory", fields: [baseVersionId], references: [id])
  corrections  AiPlanVersion[]         @relation("PlanVersionHistory")
  approval     AiPlanReviewerApproval?
  adjustmentSlot AiAdjustmentSlot?
  workoutSessions AiWorkoutSession[]
  acceptanceOutboxEntry AiPlanAcceptanceOutbox?

  @@unique([clientId, version])
  @@index([clientId, status])
}

// A10 — idempotency receipt for the accept-plan-version operation. Scoped
// to (clientId, requestKey): the same key+payload replayed returns the
// original receipt; the same key with a different payload (different
// inputDigest) is a REVISION_CONFLICT, never silently re-executed
// (docs/ai-coach/05 "Scope idempotency to authenticated owner and
// operation"). The stored `activeVersionIdAtReceiptTime` is audit-only —
// a replay must freshly re-read AiCoachProfile.activePlanVersionId rather
// than trust this cached value as current state.
model AiPlanAcceptanceReceipt {
  id                            String   @id @default(cuid())
  clientId                      String
  requestKey                    String
  inputDigest                   String
  planVersionId                 String
  alreadyAccepted               Boolean
  activeVersionIdAtReceiptTime  String? // null when replayed after the active pointer was cleared
  createdAt                     DateTime @default(now())

  client User @relation(fields: [clientId], references: [id])

  @@unique([clientId, requestKey])
}

// A10 — durable, deduplicated notification-intent record, inserted in the
// same transaction as acceptance (docs/ai-coach/05 step 5: "insert a
// deduplicated outbox event atomically"). One row per accepted plan
// version, ever — a replayed acceptance can never enqueue a second
// notification for the same version. No delivery channel is wired here;
// `processedAt` exists for a future sweep to claim, matching this
// codebase's StorageCleanupOutbox pattern.
model AiPlanAcceptanceOutbox {
  id            String    @id @default(cuid())
  planVersionId String    @unique
  clientId      String
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  client      User          @relation(fields: [clientId], references: [id])
  planVersion AiPlanVersion @relation(fields: [planVersionId], references: [id])
}

// One accepted ROUTINE change per client per canonical review window,
// permanently. Superseding, declining a later proposal, pausing, or
// re-enrolling cannot erase this row (D08).
model AiAdjustmentSlot {
  id                  String   @id @default(cuid())
  clientId            String
  reviewWindowKey     String
  acceptedPlanVersionId String @unique
  acceptedAt          DateTime @default(now())

  client            User          @relation(fields: [clientId], references: [id])
  acceptedPlanVersion AiPlanVersion @relation(fields: [acceptedPlanVersionId], references: [id])

  @@unique([clientId, reviewWindowKey])
}

// A qualified reviewer's authorization to approve AI plan versions. An
// ordinary isCoach flag is never sufficient authority (docs/ai-coach/05,
// docs/ai-coach/06 §2) — this is an explicit, revocable capability grant.
model AiCoachReviewerGrant {
  clientIds String[] @default([]) // Explicit consented case assignments; never isCoach-derived.
  domains String[] @default([]) // NUTRITION, STRENGTH, CARDIO verified capability scopes.
  id                String    @id @default(cuid())
  userId            String    @unique
  qualificationNote String    @db.Text
  grantedAt         DateTime  @default(now())
  grantedBy         String?
  revokedAt         DateTime?

  user      User                     @relation(fields: [userId], references: [id])
  approvals AiPlanReviewerApproval[]
}

// A reviewer decision binds to the exact payload hash and revisions at
// decision time — a modified candidate needs a new decision (docs/ai-coach/05).
model AiPlanReviewerApproval {
  id              String   @id @default(cuid())
  planVersionId   String   @unique
  reviewerGrantId String
  stateHash       String? // Binds policy, catalog, evidence and revisions as well as content.
  approvedHash    String
  approved        Boolean
  rationale       String   @db.Text
  decidedAt       DateTime @default(now())

  planVersion   AiPlanVersion        @relation(fields: [planVersionId], references: [id])
  reviewerGrant AiCoachReviewerGrant @relation(fields: [reviewerGrantId], references: [id])
}

// A single logged strength-training session event. Uniqueness is on the
// caller-supplied idempotency key, not on (exercise, day, week) — repeated
// sessions of the same exercise in one week must remain independent
// (mirrors F07's ExerciseResult.sessionDate fix, generalized with an
// explicit client event id instead of a derived date).
model AiWorkoutSession {
  modality String @default("STRENGTH")
  sessionInstanceId String?
  prescriptionSessionId String?
  durationMinutes Float?
  resultStatus String @default("REPORTED_PARTIAL")
  painReported Boolean @default(false)
  effortRating Int?
  inputDigest String?
  deletedAt DateTime?
  id            String     @id @default(cuid())
  clientId      String
  clientEventId String
  planVersionId String
  exerciseId    String
  occurredAt    DateTime
  timezone      String
  setIndex      Int
  reps          Int?
  loadValue     Float?
  loadUnit      String?
  loadKind      AiLoadKind?
  painNote      String?    @db.Text
  effortNote    String?    @db.Text
  revision      Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      User          @relation(fields: [clientId], references: [id])
  planVersion AiPlanVersion @relation(fields: [planVersionId], references: [id])

  @@unique([clientId, clientEventId])
  @@index([clientId, occurredAt])
}


// Durable mutation receipts shared by web/native commands. Cascade is intentional:
// account deletion must not retain intake/evidence response payloads.

// AI evidence is deliberately separate from human check-in queries: a later
// human relationship is not implicit consent to read prior AI health answers.
model AiCheckInObservation {
  id String @id @default(cuid())
  clientId String
  clientEventId String
  occurredAt DateTime
  payload Json
  revision Int @default(1)
  submitted Boolean @default(false)
  inputDigest String
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([clientId, clientEventId])
  @@index([clientId, occurredAt])
}

model AiOperationReceipt {
  id String @id @default(cuid())
  clientId String
  operation String
  requestKey String
  inputDigest String
  result Json
  createdAt DateTime @default(now())
  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@unique([clientId, operation, requestKey])
}

model IntakeFormTemplate {
  id        String   @id @default(cuid())
  coachId   String   @unique
  coach     User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachClient {
  id                        String   @id @default(cuid())
  coachId                   String
  clientId                  String
  coachNotes                String?  @db.Text
  checkInDaysOfWeekOverride Int[]    @default([]) // empty = use coach default
  cadenceConfig             Json? // CadenceConfig override (null = inherit coach default)
  adherenceEnabled          Boolean  @default(false)
  planMode                  PlanMode @default(MEAL_PLAN) // default mode for new weekly plans created for this client
  sortOrder                 Int      @default(0)
  createdAt                 DateTime @default(now())

  coach  User @relation("Coach", fields: [coachId], references: [id])
  client User @relation("Client", fields: [clientId], references: [id])

  activeForContext ClientCoachingContext?

  @@unique([coachId, clientId])
  @@index([coachId])
  @@index([clientId])
}

// ── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoPath    String?
  description String?
  createdAt   DateTime @default(now())

  members User[]
  invites TeamInvite[]
}

model TeamInvite {
  id          String       @id @default(cuid())
  teamId      String
  inviteToken String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  expiresAt   DateTime

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([inviteToken])
}

model CheckInTemplate {
  id        String   @id @default(cuid())
  coachId   String
  name      String
  isDefault Boolean  @default(false)
  version   Int      @default(1)
  questions Json // Array of question objects (see lib/validations/check-in-template.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach    User      @relation("CheckInTemplates", fields: [coachId], references: [id])
  checkIns CheckIn[]

  @@index([coachId])
}

model CheckIn {
  id             String        @id @default(cuid())
  clientId       String
  weekOf         DateTime
  weight         Float?
  bodyFatPct     Float?
  status         CheckInStatus @default(SUBMITTED)
  dietCompliance Int?
  energyLevel    Int?
  notes          String?       @db.Text
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  isPrimary       Boolean  @default(true)
  submittedAt     DateTime @default(now())
  localDate       String   @default("")
  timezone        String   @default("America/Los_Angeles")
  periodStartDate String   @default("") // "YYYY-MM-DD" start of schedule-defined period
  periodEndDate   String   @default("") // "YYYY-MM-DD" next scheduled day (exclusive end)

  templateId       String?
  templateSnapshot Json? // Frozen copy of template.questions at submission time
  customResponses  Json? // Answers to custom template questions

  client   User             @relation(fields: [clientId], references: [id])
  template CheckInTemplate? @relation(fields: [templateId], references: [id])
  photos   CheckInPhoto[]

  @@index([clientId, weekOf])
  @@index([clientId, submittedAt])
  @@index([clientId, localDate])
  @@index([clientId, periodStartDate])
}

model MacroTarget {
  id        String   @id @default(cuid())
  clientId  String
  weekOf    DateTime
  calories  Int
  protein   Int
  carbs     Int
  fats      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client User @relation("MacroTargets", fields: [clientId], references: [id])

  @@unique([clientId, weekOf])
}

enum MealPlanStatus {
  DRAFT
  PUBLISHED
  // A plan that was published but has since been replaced by a newer
  // published plan for the same client/week. Content is retained (CB04 —
  // clients keep prior published history); only PUBLISHED is "current."
  SUPERSEDED
}

// MEAL_PLAN = coach fills in real foods (MealPlanItem rows, existing behavior).
// MACROS    = coach fills in per-meal macro targets only (MealMacroTarget rows), no foods shown.
enum PlanMode {
  MEAL_PLAN
  MACROS
}

model MealPlan {
  id             String         @id @default(cuid())
  clientId       String
  weekOf         DateTime
  version        Int            @default(1)
  status         MealPlanStatus @default(DRAFT)
  planMode       PlanMode       @default(MEAL_PLAN)
  supportContent String?        @db.Text
  planExtras     Json? // PlanExtras object (see types/meal-plan-extras.ts)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client       User              @relation("MealPlans", fields: [clientId], references: [id])
  items        MealPlanItem[]
  macroTargets MealMacroTarget[]

  @@unique([clientId, weekOf, version])
  @@index([clientId, weekOf])
  @@index([clientId, status])
}

model MealPlanItem {
  id                 String  @id @default(cuid())
  mealPlanId         String
  mealName           String
  sortOrder          Int     @default(0)
  foodName           String
  quantity           String
  unit               String
  servingDescription String?
  calories           Int     @default(0)
  protein            Int     @default(0)
  carbs              Int     @default(0)
  fats               Int     @default(0)

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
}

/**
 * Per-meal macro-only target — sibling to MealPlanItem, used when MealPlan.planMode = MACROS.
 */
model MealMacroTarget {
  id         String @id @default(cuid())
  mealPlanId String
  mealName   String
  sortOrder  Int    @default(0)
  calories   Int    @default(0)
  protein    Int    @default(0)
  carbs      Int    @default(0)
  fats       Int    @default(0)

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
}

model Message {
  id        String   @id @default(cuid())
  clientId  String
  weekOf    DateTime
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  // The specific coach this message belongs to (the other participant in
  // the conversation, from the client's perspective). Set at creation time
  // from the resolved current coach, independent of whether the CoachClient
  // relationship still exists later (CoachClient rows are hard-deleted on
  // disconnect). Pre-migration rows were attributed in two steps:
  // 20260913200000_message_coach_scope claimed coach-authored rows by their
  // sender, then 20260915000000_message_coach_backfill_single_coach (T-661)
  // attributed the remainder only where all three held: exactly one
  // CoachClient row exists, ClientCoachingContext names that row as the
  // active HUMAN relationship (or no context row exists at all, the legacy
  // fallback), and either no other coach's message appears anywhere in the
  // client's history or the surviving relationship provably began after the
  // last of them. That is a strict subset of what getClientProvider would
  // name, never a superset. It is bounded to the period the relationship
  // demonstrably existed and clamped to start strictly after any other
  // coach's last message, so a successor never inherits a predecessor's
  // thread. Where the surviving relationship row PREDATES another coach's
  // activity, no lower bound can be evidenced at all and nothing is
  // attributed for that client.
  // Null means "no single coach can be attributed": the client has 0 or 2+
  // CoachClient rows, their coaching context is resolutionRequired or AI, the
  // message was sent while unassigned, it predates the attribution window, it
  // falls inside another coach's conversation, or the client's history
  // interleaves a second coach in an order no evidence can split. A coach can
  // only ever read
  // messages where this matches their own id; the client's own view is never
  // filtered by it (CB03 — conversations are participant-scoped, but the
  // client keeps their full archive). Since T-672 coach surfaces read through
  // getCoachThread(clientId, coachId) (lib/queries/messages.ts), which cannot
  // be called without a coach id; getAllMessages/getMessages take an optional
  // asCoachId and are unfiltered only when it is omitted, for the client's own
  // archive. That last clause corrects the parentheticals in the applied
  // migrations 20260913200000_message_coach_scope and
  // 20260915000000_message_coach_backfill_single_coach, which say those
  // functions are "never coach-filtered". For getAllMessages that was true
  // when written and false since T-672. For getMessages it was already
  // inaccurate on arrival: asCoachId was added to it by c64074f (F03), the
  // same commit that added the first of those migrations, so getMessages has
  // never been unscoped for a coach and this ticket does not touch it.
  // Applied migration SQL is checksummed and is never edited.
  coachId String?

  client User  @relation("ClientMessages", fields: [clientId], references: [id])
  sender User  @relation("SentMessages", fields: [senderId], references: [id])
  coach  User? @relation("CoachScopedMessages", fields: [coachId], references: [id])

  @@index([clientId, weekOf])
  @@index([senderId])
  @@index([clientId, coachId])
}

// ── Messaging Safety: Block & Report ────────────────────────────────────────

